{
  "comments": { "lineComment": "//" },
  "brackets": [["(", ")"], ["[", "]"], ["{", "}"]],
  "autoClosingPairs": [
    { "open": "(", "close": ")" }, { "open": "[", "close": "]" },
    { "open": "{", "close": "}" }, { "open": "$", "close": "$" },
    { "open": "\"", "close": "\"" }
  ],
  "surroundingPairs": [["$", "$"], ["*", "*"], ["`", "`"], ["(", ")"], ["[", "]"]],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(theorem|lemma|proposition|corollary|definition|example|remark|proof|abstract|quote|figure|references|define block)\\b.*$|\\bdo$",
    "decreaseIndentPattern": "^\\s*end$"
  }
}
