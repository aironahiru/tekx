== tree
document test/golden/math.tekx
  define@1:8 function phi
  define@2:8 operator Tr
  define@3:8 norm2(v) as ||v||_2 read as "the two-norm of {v}"
  para@5 0
    text Inline: 
    math@5:10 a^2 + b^2 = c^2
    text , 
    math@5:29 1/2 x
    text , 
    math@5:38 h/2pi
    text , 
    math@5:47 sin x / x
    text , 
    math@5:60 norm2(x - y)
    text , 
    math@5:76 Tr A
    text , 
    math@5:84 phi(t)
    text .
  display@7
    line@7:5 gauss sum k for k from 1 to n = n(n + 1)/2
    line@8:5 - integral of f(x) dx from a to b = F(b) - F(a)
    line@9:5 - limit of (1 + 1/n)^n as n approaches infinity = e
  display@11
    line@11:5 - (a + b)^2 = a^2 + 2 a b + b^2
    line@12:15 - = b^2 + 2 a b + a^2
    line@13:15 - + 0
  display@15
    line@15:5 - abs(x) = cases
      cont@16:7 x    if x >= 0
      cont@17:7 -x   otherwise
  display@19
    line@19:5 - R(theta) = matrix
      cont@20:7 cos theta  -sin theta
      cont@21:7 sin theta  cos theta
  display@23
    line@23:5 - x = y & + z
== mathematics
mathml <math xmlns="http://www.w3.org/1998/Math/MathML" display="inline" alttext="a squared plus b squared equals c squared"><semantics><mrow><mrow><msup><mi>𝑎</mi><mn>2</mn></msup><mo>+</mo><msup><mi>𝑏</mi><mn>2</mn></msup></mrow><mo>=</mo><msup><mi>𝑐</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tekx">a^2 + b^2 = c^2</annotation></semantics></math>
