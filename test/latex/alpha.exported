\begin{abstract}
We improve the exponent $1/2$ of \cite[Thm. 2]{hooley}, \cite{landau}.

\end{abstract}

\maketitle

\section{Introduction}\label{intro}

Landau \cite{landau} proved

\begin{equation}\label{asym}
  B(x) \sim K \frac{x}{\sqrt{\log x}}
\end{equation}

By \hyperref[main]{Main Theorem} and Lemmas \ref{a} and \ref{b}, see \eqref{asym} and Section~\ref{intro}; also \cite{vallee,erdos,thesis,arxiv,parens} and \cite[\S{}2]{arxiv}. The paper \cite{hooley} and the formula \eqref{asym} are different things.

\begin{theorem*}[Main Theorem]\label{main}
Every interval $[x, x + x^{1/4 + \varepsilon}]$ contains one.

\end{theorem*}

\begin{lemma}\label{a}
First.

\end{lemma}

\begin{lemma}\label{b}
Second, by \cite[p. $305$]{landau}.

\end{lemma}

