\section{Computations}\label{comp}

\begin{lemma}\label{c}
As in Appendix~\ref{comp}, Lemma~\ref{c} holds:

\begin{equation}\label{bound}
  g(x) \leq 2 x^{1/4}
\end{equation}

\end{lemma}

